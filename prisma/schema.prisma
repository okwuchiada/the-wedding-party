// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model RegistryItem {
  id            String         @id @default(cuid())
  wedding       Wedding        @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  weddingId     String
  name          String
  category      String
  priceCents    Int
  image         String
  externalUrl   String?
  claimedBy     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  contributions Contribution[]

  @@index([weddingId])
}

enum ContributionStatus {
  AWAITING_CONFIRMATION
  CONFIRMED
}

model Contribution {
  id             String             @id @default(cuid())
  wedding        Wedding            @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  weddingId      String
  registryItem   RegistryItem       @relation(fields: [registryItemId], references: [id])
  registryItemId String
  guestName      String
  amountCents    Int
  note           String?
  status         ContributionStatus @default(AWAITING_CONFIRMATION)
  createdAt      DateTime           @default(now())
  confirmedAt    DateTime?

  @@index([weddingId])
}

enum MediaType {
  PHOTO
  VIDEO
}

enum MediaStatus {
  PENDING
  APPROVED
  HIDDEN
}

model Media {
  id        String      @id @default(cuid())
  wedding   Wedding     @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  weddingId String
  guestName String
  url       String
  type      MediaType
  status    MediaStatus @default(PENDING)
  createdAt DateTime    @default(now())

  @@index([weddingId])
}

enum WishStatus {
  PENDING
  APPROVED
  HIDDEN
}

model Wish {
  id        String     @id @default(cuid())
  wedding   Wedding    @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  weddingId String
  guestName String
  message   String
  status    WishStatus @default(PENDING)
  createdAt DateTime   @default(now())

  @@index([weddingId])
}

model StoryContent {
  id             String   @id @default(cuid())
  wedding        Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  weddingId      String   @unique
  brideName      String
  groomName      String
  weddingDate    DateTime
  tagline        String?
  location       String?
  venueAddress   String?
  howWeMet       String?
  whatWeLove     String?
  groomNote      String?
  brideNote      String?
  heroPhotoUrl   String?
  contactEmail   String?
  bridePhone     String?
  groomPhone     String?
  galleryEnabled Boolean  @default(false)
  updatedAt      DateTime @updatedAt
}

model Rsvp {
  id                 String    @id @default(cuid())
  wedding            Wedding   @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  weddingId          String
  guestName          String
  email              String
  attending          Boolean
  guestCount         Int       @default(1)
  message            String?
  ipAddress          String?
  userAgent          String?
  createdAt          DateTime  @default(now())
  confirmationSentAt DateTime?

  @@index([weddingId, createdAt])
  @@index([weddingId, ipAddress, createdAt])
}

model StoryPhoto {
  id         String  @id @default(cuid())
  wedding    Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  weddingId  String
  url        String
  caption    String
  order      Int     @default(0)
  showInHero Boolean @default(false)

  @@index([weddingId])
}

model StoryBeat {
  id        String  @id @default(cuid())
  wedding   Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  weddingId String
  year      String
  title     String
  text      String
  photoUrl  String?
  order     Int     @default(0)

  @@index([weddingId])
}

model BankDetails {
  id        String   @id @default(cuid())
  wedding   Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  weddingId String   @unique
  name      String
  bank      String
  account   String
  routing   String
  swift     String?
  updatedAt DateTime @updatedAt
}

// ─── Tenancy, accounts and billing ──────────────────────────────────────────

enum UserRole {
  USER
  SUPER_ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  // Null until the user sets a password (invited partners, migrated couples).
  passwordHash String?
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships WeddingMember[]
  resetTokens PasswordResetToken[]
  auditLogs   AuditLog[]
}

enum WeddingStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  ARCHIVED
}

model Wedding {
  id               String        @id @default(cuid())
  slug             String        @unique
  status           WeddingStatus @default(DRAFT)
  plan             Plan?         @relation(fields: [planId], references: [id])
  planId           String?
  paidAt           DateTime?
  // Granted a plan by a super admin without paying.
  comped           Boolean       @default(false)
  currency         String        @default("NGN")
  locale           String        @default("en-NG")
  timezone         String        @default("Africa/Lagos")
  phoneCountryCode String        @default("234")
  maxGuests        Int           @default(100)
  // ISO country codes allowed to view the guest site; empty means everyone.
  allowedCountries String[]      @default([])
  geoBypassToken   String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  members       WeddingMember[]
  theme         WeddingTheme?
  copy          WeddingCopy?
  story         StoryContent?
  bankDetails   BankDetails?
  registryItems RegistryItem[]
  contributions Contribution[]
  media         Media[]
  wishes        Wish[]
  rsvps         Rsvp[]
  storyPhotos   StoryPhoto[]
  storyBeats    StoryBeat[]
  payments      Payment[]
  auditLogs     AuditLog[]
}

enum WeddingRole {
  OWNER
  EDITOR
}

model WeddingMember {
  id        String      @id @default(cuid())
  wedding   Wedding     @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  weddingId String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  role      WeddingRole @default(EDITOR)
  createdAt DateTime    @default(now())

  @@unique([weddingId, userId])
  @@index([userId])
}

model WeddingTheme {
  id           String  @id @default(cuid())
  wedding      Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  weddingId    String  @unique
  presetKey    String  @default("terracotta-olive")
  // Overrides on top of the preset: { background, foreground, primary, ... }
  colors       Json    @default("{}")
  serifFont    String?
  scriptFont   String?
  sansFont     String?
  heroImageUrl String?
}

// Section copy overrides; null fields fall back to the component defaults.
model WeddingCopy {
  id             String  @id @default(cuid())
  wedding        Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  weddingId      String  @unique
  heroEyebrow    String?
  heroIntro      String?
  rsvpIntro      String?
  registryIntro  String?
  giftIntro      String?
  loveNotesIntro String?
  galleryIntro   String?
  wishesIntro    String?
  footerCredit   String?
  asoebiEnabled  Boolean @default(false)
  asoebiFabric   String?
}

model Plan {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  priceKobo Int
  maxGuests Int
  // { gallery: boolean, customTheme: boolean, removeBranding: boolean }
  features  Json     @default("{}")
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  weddings Wedding[]
  payments Payment[]
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model Payment {
  id              String        @id @default(cuid())
  wedding         Wedding       @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  weddingId       String
  plan            Plan          @relation(fields: [planId], references: [id])
  planId          String
  reference       String        @unique
  amountKobo      Int
  status          PaymentStatus @default(PENDING)
  paystackPayload Json?
  createdAt       DateTime      @default(now())
  paidAt          DateTime?

  @@index([weddingId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  // SHA-256 of the token; the raw token only ever lives in the emailed link.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId   String?
  wedding   Wedding? @relation(fields: [weddingId], references: [id], onDelete: SetNull)
  weddingId String?
  action    String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([weddingId, createdAt])
  @@index([createdAt])
}
